# Export these variables in your shell or pass this file to Docker Compose.
# Django does not automatically load this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://cacaca:CHANGE_ME@db:5432/cacaca
CSRF_TRUSTED_ORIGINS=
POSTGRES_PASSWORD=
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
MEDIA_STORAGE_OPTIONS={}
MEDIA_URL=/media/
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=website@localhost
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
PUBLIC_BASE_URL=https://your-domain.example
# Keep search indexing off for local development and staging. Enable only for the public launch domain.
SITE_INDEXABLE=false
# Temporary hosted owner review only. Store a SHA-256 hex digest of a random one-time setup code.
CACACA_REVIEW_MODE=false
CACACA_OWNER_SETUP_CODE_HASH=

# PayPal sandbox only during development. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
